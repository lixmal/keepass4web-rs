# Environment for docker-compose.yml and the optional auth test services in it.
# docker compose reads .env automatically, so copy this file and edit it:
#
#   cp .env.example .env
#
# Everything here is a throwaway value for local testing. Nothing in this file
# configures the app itself — that is config.yml. These variables only set the
# ports the stack publishes and the credentials the test services are seeded
# with, so config.yml and this file have to agree where they overlap; each
# variable below says when they do.


### The app ###

# Host port the app is published on: http://localhost:${APP_PORT}
# The OIDC client in tests/keycloak/realm.json registers its redirect URI as
# http://localhost:8080/callback_user_auth, so changing this also means changing
# the client's redirect URI in Keycloak, or the login will be rejected.
APP_PORT=8080


### OpenLDAP (auth_backend: LDAP) ###

# Host port the LDAP server is published on. Inside the compose network the app
# reaches it as ldap://openldap:1389 regardless of this; this is the port to use
# when the app runs outside compose: ldap://127.0.0.1:${LDAP_PORT}
LDAP_PORT=1389

# Root of the directory tree. Everything below is created underneath it, and it
# is what config.yml's base_dn and bind DN have to be built from:
#   base_dn: 'ou=users,${LDAP_ROOT}'
#   bind:    'cn=${LDAP_ADMIN_USERNAME},${LDAP_ROOT}'
LDAP_ROOT=dc=example,dc=org

# Directory administrator. The app binds as this user to search for the person
# logging in, then rebinds as that person to check their password, so this
# account only needs read access. It goes in config.yml as bind/password.
LDAP_ADMIN_USERNAME=admin
LDAP_ADMIN_PASSWORD=adminpassword

# A user seeded into the directory so there is someone to log in as. Created
# under ou=users with uid=${LDAP_TEST_USER}, which is why config.yml uses
# login_attribute: 'uid'.
LDAP_TEST_USER=testuser
LDAP_TEST_PASSWORD=testpass


### Keycloak (auth_backend: OIDC) ###

# Host port the login page and admin console are reached on.
KC_PORT=8081

# The URL a browser uses to reach Keycloak. Keycloak derives the issuer and
# every endpoint in its discovery document from this, so it has to be an address
# the browser can actually open — not the compose service name. It is passed to
# Keycloak as --hostname, and config.yml repeats it as the OIDC issuer:
#   issuer: '${KC_PUBLIC_URL}/realms/${OIDC_REALM}'
# Keep the port in it the same as KC_PORT.
KC_PUBLIC_URL=http://localhost:8081

# Admin console login at ${KC_PUBLIC_URL}. Only for looking around the realm;
# the app never uses these.
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=admin

# Imported on startup from tests/keycloak/realm.json. The realm holds a
# confidential client with the id and secret below and a user
# 'testuser' / 'testpass'. All three are repeated in config.yml under OIDC:
#   client_id / client_secret, and the realm as part of the issuer URL.
# Changing them here does not change the imported realm — edit realm.json too.
OIDC_REALM=keepass
OIDC_CLIENT_ID=keepass4web
OIDC_CLIENT_SECRET=insecure-example-client-secret
