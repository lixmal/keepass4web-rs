{
    "name": "KeePass4Web",
    "version": "1.0.0",
    "description": "Web KeePass application",
    "main": "js/scripts/app.js",
    "scripts": {
        "test": "playwright test --reporter=list",
        "test:ui": "playwright test --ui",
        "test:headed": "playwright test --headed --reporter=list",
        "dev": "./node_modules/.bin/browserify -t browserify-css -t babelify js/scripts/app.js -o public/scripts/bundle.js",
        "watch": "./node_modules/.bin/watchify -t browserify-css -t babelify js/scripts/app.js -o public/scripts/bundle.js",
        "build": "NODE_ENV=production ./node_modules/.bin/browserify -t browserify-css -t babelify js/scripts/app.js | terser --compress --mangle > public/scripts/bundle.js"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/lixmal/keepass4web-rs"
    },
    "keywords": [
        "keepass"
    ],
    "author": "Viktor Liu",
    "license": "GPL-3.0",
    "bugs": {
        "url": "https://github.com/lixmal/keepass4web-rs/issues"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "@playwright/test": "^1.62.1",
        "babelify": "^10.0.0",
        "browserify": "^17.0.1",
        "browserify-css": "^0.15.0",
        "core-js": "^3.50.0",
        "terser": "^5.51.2",
        "watchify": "^4.0.0"
    },
    "dependencies": {
        "classnames": "^2.5.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router": "^8.3.1"
    },
    "browserify-css": {
        "autoInject": true,
        "minify": true,
        "rootDir": "."
    },
    "babel": {
        "presets": [
            "@babel/preset-env",
            "@babel/preset-react"
        ]
    }
}
